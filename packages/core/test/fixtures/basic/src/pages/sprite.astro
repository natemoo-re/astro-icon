---
import { Icon, Sprite } from "astro-icon/components";
import IconRow from "../components/IconRow.astro";
---

<html>
  <body>
    <Sprite>
      <!-- Repeated icon inside the Sprite boundary -> one <symbol>, three <use>s -->
      <Icon name="3-dots-fade" />
      <Icon name="3-dots-fade" />
      <Icon name="3-dots-fade" title="Third" />
      <!-- A second distinct icon inside the same Sprite boundary -->
      <Icon name="spinners:3-dots-fade" />
      <!-- Icons nested two levels deep inside another Astro component -->
      <IconRow />
    </Sprite>
    <!-- Outside the Sprite boundary -> always plain, never deduped -->
    <Icon name="3-dots-fade" />
  </body>
</html>
