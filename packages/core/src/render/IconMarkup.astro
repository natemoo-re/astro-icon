---
/**
 * The `<svg>` markup shared by `<Icon>`/`<LiveIcon>` once each has already resolved its entry and
 * computed `normalizedProps`/a11y ids via `renderableIconProps`/`iconA11yProps` - the only parts
 * that differ between the two (how an entry is resolved, and each's own error-vs-warn philosophy
 * on a miss) stay in their own `.astro` files.
 */
export interface Props {
  normalizedProps: Record<string, unknown>;
  titleId?: string;
  titleText?: string;
  descId?: string;
  descText?: string;
  body: string;
  /** The `data-icon` marker's value - see CONTEXT.md's "Icon marker". */
  dataIcon: string;
  /** Set on `<LiveIcon>` output only - see CONTEXT.md's "Sprite boundary" for why. */
  dataIconLive?: boolean;
}

const {
  normalizedProps,
  titleId,
  titleText,
  descId,
  descText,
  body,
  dataIcon,
  dataIconLive,
} = Astro.props;
---

<svg {...normalizedProps} data-icon={dataIcon} data-icon-live={dataIconLive}>
  {titleId && <title id={titleId}>{titleText}</title>}
  {descId && <desc id={descId}>{descText}</desc>}
  <Fragment set:html={body} />
</svg>
