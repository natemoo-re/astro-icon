---
import { replaceIDs } from "@iconify/utils";
import type { HTMLAttributes } from "astro/types";
import {
  iconA11yProps,
  renderableIconProps,
  type AccessibleElementInput,
} from "./props.js";
import type { SpriteRenderMode } from "./spriteMode.js";
import type { IconEntry } from "../../typings/types";

/**
 * Everything shared by `<Icon>`/`<LiveIcon>` once each has already resolved its entry: computing
 * a11y attributes/ids (`iconA11yProps`), the final `<svg>` props (`renderableIconProps`),
 * generating unique element ids in the body (`replaceIDs`), and the markup itself. The only parts
 * that differ between the two - how an entry is resolved, and each's own error-vs-warn philosophy
 * on a miss - stay in their own `.astro` files.
 */
export interface Props {
  entry: IconEntry;
  title?: string | AccessibleElementInput;
  desc?: string | AccessibleElementInput;
  /** Every other prop the caller passed - spread onto the rendered `<svg>` after the computed a11y/size defaults, so the caller's own values always win. */
  svgProps: HTMLAttributes<"svg"> & {
    "aria-description"?: string;
    size?: number | string;
  };
  /** The `data-icon` marker's value - see CONTEXT.md's "Icon marker". */
  dataIcon: string;
  /** Set on `<LiveIcon>` output only - see CONTEXT.md's "Sprite boundary" for why. */
  dataIconLive?: boolean;
  /**
   * Automatic sprite optimization's render decision for this occurrence - set by `<Icon>` only.
   * `<LiveIcon>` never passes this: it resolves per-request, so there's no build-time asset to
   * reference, and it already opts out of sprite-eligible page rewriting via `dataIconLive`.
   */
  renderMode?: SpriteRenderMode;
}

const { entry, title, desc, svgProps, dataIcon, dataIconLive, renderMode } =
  Astro.props;

// `entry.title`/`.desc` are the icon's own defaults (e.g. a local `.svg`'s inline `<title>`/
// `<desc>`) - only used when the caller didn't pass their own, same as every other prop here.
const { a11yProps, titleId, descId, titleText, descText } = iconA11yProps(
  title ?? entry.title,
  desc ?? entry.desc,
  svgProps,
);
const { normalizedProps } = renderableIconProps(entry, {
  ...a11yProps,
  ...svgProps,
});
const renderedBody = replaceIDs(entry.body);
---

<svg
  {...normalizedProps}
  data-icon={dataIcon}
  data-icon-live={dataIconLive}
  data-icon-inline={renderMode?.kind === "inline" ? "" : undefined}
>
  {titleId && <title id={titleId}>{titleText}</title>}
  {descId && <desc id={descId}>{descText}</desc>}
  {
    renderMode?.kind === "asset" ? (
      <use href={renderMode.href} />
    ) : (
      <Fragment set:html={renderedBody} />
    )
  }
</svg>
