---
import { getEntry } from "astro:content";
import type { HTMLAttributes } from "astro/types";
import { AstroIconError } from "../src/core/AstroIconError.js";
import { parseIconName } from "../src/core/parseName.js";
import { renderableIconProps } from "../src/core/renderableIconProps.js";
import type { IconName } from "../typings/names";
import type { IconEntry } from "../typings/types";

interface AccessibleElementProps {
  id?: string;
  value: string;
}

interface Props extends HTMLAttributes<"svg"> {
  name: IconName;
  title?: string | AccessibleElementProps;
  desc?: string | AccessibleElementProps;
  size?: number | string;
  width?: number | string;
  height?: number | string;
}

const { name = "", title, desc, ...props } = Astro.props;

const normalizeAccessibleElement = (value?: string | AccessibleElementProps) =>
  typeof value === "string" ? { value } : value;
const normalizedTitle = normalizeAccessibleElement(title);
const normalizedDesc = normalizeAccessibleElement(desc);

const { collection, name: iconName, hasPrefix } = parseIconName(name as string);

if (!iconName) {
  throw new AstroIconError(
    `Invalid "name" provided!`,
    import.meta.env.DEV
      ? `The provided value of "${name}" is invalid.\n\nDid you mean to provide an icon name?`
      : undefined,
  );
}

let entry: { data: IconEntry } | undefined;
try {
  entry = (await getEntry(collection as never, iconName)) as
    | { data: IconEntry }
    | undefined;
} catch {
  entry = undefined;
}

if (!entry) {
  throw new AstroIconError(
    `Unable to locate "${name}" icon!`,
    import.meta.env.DEV
      ? hasPrefix
        ? `The "${collection}" collection doesn't have an icon named "${iconName}".\n\nDid you define a collection named "${collection}" in "src/content.config.ts", and does it include this icon?`
        : `No collection named "icons" produced an icon named "${iconName}".\n\nBare names resolve to a collection literally named "icons" - define one in "src/content.config.ts", or use the "collection:name" form (e.g. "${iconName}" from a specific pack).`
      : undefined,
  );
}

const { body } = entry.data;
const { normalizedProps } = renderableIconProps(entry.data, collection, iconName, props);
---

<svg {...normalizedProps} data-icon={name}>
  {
    normalizedTitle && (
      <title id={normalizedTitle.id}>{normalizedTitle.value}</title>
    )
  }
  {normalizedDesc && <desc id={normalizedDesc.id}>{normalizedDesc.value}</desc>}
  <Fragment set:html={body} />
</svg>
