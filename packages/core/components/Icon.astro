---
import IconBase from "./IconBase.astro";
import type { IconProps } from "../src/render/props.js";
import { prepareIcon } from "../src/render/prepareIcon.js";

/**
 * Renders one icon from a content collection as an inline `<svg>`, resolved
 * at build time. `IconName` autocompletes from every collection you define
 * in `content.config.ts`, once you've run `astro sync`, `dev`, or `build`.
 *
 * Decorative by default (`aria-hidden`, invisible to assistive tech), since
 * most icons sit next to visible text or inside an already-labeled control.
 * Providing `title`/`desc` (or your own
 * `aria-label`/`aria-labelledby`/`aria-description`/`aria-describedby`)
 * opts an icon out of that default into a labeled, standalone graphic.
 *
 * Handles any icon name the build can enumerate ahead of time, even one
 * computed from data or picked by a user from an installed pack. Use
 * `<LiveIcon>` instead only when the collection itself can't be enumerated
 * at build time: an API with no fixed catalog, or a name from a system
 * outside this build entirely.
 */
interface Props extends IconProps {}

const { name = "", ...props } = Astro.props;

const { entry, marker } = await prepareIcon(name as string);
---

<IconBase entry={entry} dataIcon={marker} {...props} />
