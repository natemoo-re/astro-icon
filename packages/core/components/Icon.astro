---
import type { HTMLAttributes } from "astro/types";
import { renderTimeError } from "../src/render/error.js";
import IconMarkup from "../src/render/IconMarkup.astro";
import { iconA11yProps, renderableIconProps } from "../src/render/props.js";
import type { AccessibleElementInput } from "../src/render/props.js";
import { parseIconName } from "../src/render/parseIconName.js";
import { resolveIconEntry } from "../src/render/lookupEntry.js";
import type { IconName } from "../typings/names";

/**
 * Renders one icon from a content collection as an inline `<svg>`, resolved
 * at build time. `IconName` autocompletes from every collection you define
 * in `content.config.ts`, once you've run `astro sync`, `dev`, or `build`.
 *
 * Decorative by default (`aria-hidden`, invisible to assistive tech), since
 * most icons sit next to visible text or inside an already-labeled control.
 * Providing `title`/`desc` (or your own
 * `aria-label`/`aria-labelledby`/`aria-description`/`aria-describedby`)
 * opts an icon out of that default into a labeled, standalone graphic.
 *
 * Use `<LiveIcon>` instead when you need to resolve an icon per request.
 */
interface Props extends HTMLAttributes<"svg"> {
  /** `"collection:icon"`, or a bare icon name if you have a collection named `icons`. */
  name: IconName;
  /**
   * Adds an accessible `<title>` before the icon body, and takes the icon out
   * of its decorative default. Pass `{ id, value }` instead of a plain string
   * to control the `<title>`'s id, e.g. so something outside the icon can
   * reference it directly.
   */
  title?: string | AccessibleElementInput;
  /**
   * Adds an accessible `<desc>` after `title`, and takes the icon out of its
   * decorative default. Pass `{ id, value }` instead of a plain string to
   * control the `<desc>`'s id, e.g. so something outside the icon can
   * reference it directly.
   */
  desc?: string | AccessibleElementInput;
  /**
   * Sets the icon's accessible description inline, without a separate
   * `<desc>` element to reference. Same relationship to `aria-describedby`
   * as `aria-label` has to `aria-labelledby`.
   *
   * This is a WAI-ARIA 1.3 attribute that Astro's `HTMLAttributes` type
   * doesn't include yet, so it's declared here explicitly.
   */
  "aria-description"?: string;
  /** Sets both `width` and `height` at once. Takes priority over either if both are set. */
  size?: number | string;
  /** The icon's rendered width; defaults to the source SVG's own width. Pass `null` to omit the attribute entirely, e.g. to size the icon from CSS instead. */
  width?: number | string | null;
  /** The icon's rendered height; defaults to the source SVG's own height. Pass `null` to omit the attribute entirely, e.g. to size the icon from CSS instead. */
  height?: number | string | null;
}

const { name = "", title, desc, ...props } = Astro.props;

const parsedName = parseIconName(name as string);
const { collection, name: iconName, hasPrefix } = parsedName;

if (!iconName) {
  throw renderTimeError(
    `Invalid "name" provided!`,
    `The provided value of "${name}" is invalid.\n\nDid you mean to provide an icon name?`,
  );
}

const entry = await resolveIconEntry(collection, iconName);

if (!entry) {
  throw renderTimeError(
    `Unable to locate "${name}" icon!`,
    hasPrefix
      ? `The "${collection}" collection doesn't have an icon named "${iconName}".\n\nDid you define a collection named "${collection}" in "src/content.config.ts", and does it include this icon?`
      : `No collection named "icons" produced an icon named "${iconName}".\n\nBare names resolve to a collection literally named "icons": define one in "src/content.config.ts", or use the "collection:name" form (e.g. "${iconName}" from a specific pack).`,
  );
}

const { a11yProps, titleId, descId, titleText, descText } = iconA11yProps(
  title,
  desc,
  props,
);
const { normalizedProps } = renderableIconProps(entry.data, {
  ...a11yProps,
  ...props,
});
---

<IconMarkup
  normalizedProps={normalizedProps}
  titleId={titleId}
  titleText={titleText}
  descId={descId}
  descText={descText}
  body={entry.data.body}
  dataIcon={name}
/>
