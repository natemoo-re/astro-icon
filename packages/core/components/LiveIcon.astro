---
import { getLiveEntry } from "astro:content";
import type { HTMLAttributes } from "astro/types";
import { AstroIconError, renderTimeError } from "../src/core/AstroIconError.js";
import { iconA11yProps } from "../src/core/iconA11yProps.js";
import { renderableIconProps } from "../src/core/renderableIconProps.js";
import type { LiveCollectionName } from "../typings/names";
import type { IconEntry } from "../typings/types";

/**
 * Renders one icon from a live collection as an inline `<svg>`, resolved at
 * request time instead of build time. Use it when you can't know your icon
 * names ahead of time, such as a user-driven icon search.
 *
 * Requires `defineLiveCollection()` in `live.config.ts` and Astro's
 * `experimental.liveContentCollections` flag. If the icon fails to resolve,
 * `<LiveIcon>` logs a warning and renders nothing rather than throwing, so
 * one bad icon doesn't take down the page.
 *
 * Decorative by default (`aria-hidden`, invisible to assistive tech) - the
 * common case, since most icons sit next to visible text or inside an
 * already-labeled control. Providing `title`/`desc` (or your own
 * `aria-label`/`aria-labelledby`/`aria-description`/`aria-describedby`)
 * opts an icon out of that default into a labeled, standalone graphic.
 *
 * Use `<Icon>` instead when your icon names are known at build time; it's
 * cheaper since it resolves once, not on every request.
 */
interface Props extends HTMLAttributes<"svg"> {
  /** The live collection to resolve `icon` from; live collections have no default, unlike `<Icon>`. */
  collection: LiveCollectionName;
  /**
   * The icon's name within `collection`. Always a plain `string`: live
   * collections resolve per-request, so the exact value is often only known
   * at runtime (e.g. a user-driven search) and can't be checked at sync time.
   */
  icon: string;
  /** Adds an accessible `<title>` before the icon body, and takes the icon out of its decorative default. */
  title?: string;
  /** Adds an accessible `<desc>` after `title`, and takes the icon out of its decorative default. */
  desc?: string;
  /** Astro's types don't yet include this WAI-ARIA 1.3 attribute; the direct-string analog of `aria-describedby`, same relationship as `aria-label`/`aria-labelledby`. */
  "aria-description"?: string;
  /** Sets both `width` and `height` at once. Takes priority over either if both are set. */
  size?: number | string;
  width?: number | string;
  height?: number | string;
}

const { collection, icon, title, desc, ...props } = Astro.props;

if (!collection || !icon) {
  throw renderTimeError(
    `Invalid "collection" or "icon" provided!`,
    `<LiveIcon> requires both a "collection" and an "icon" prop; got collection="${collection}", icon="${icon}".`,
  );
}

const { entry, error } = await getLiveEntry(collection, icon);

if (error || !entry) {
  const hint = error instanceof AstroIconError ? error.hint : undefined;
  console.warn(
    `<LiveIcon> failed to load "${collection}:${icon}"${error ? `: ${error.message}` : ""}${hint ? `\nHint: ${hint}` : ""}`,
  );
  return;
}

const data = entry.data as IconEntry;
const { a11yProps, titleId, descId } = iconA11yProps(title, desc, props);
const { normalizedProps } = renderableIconProps(data, { ...a11yProps, ...props });
---

<svg {...normalizedProps} data-icon={`${collection}:${icon}`} data-icon-live>
  {titleId && <title id={titleId}>{title}</title>}
  {descId && <desc id={descId}>{desc}</desc>}
  <Fragment set:html={data.body} />
</svg>
