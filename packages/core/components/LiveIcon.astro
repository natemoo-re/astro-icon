---
import { getLiveEntry } from "astro:content";
import type { HTMLAttributes } from "astro/types";
import { AstroIconError } from "../src/internal/error.js";
import { renderTimeError } from "../src/render/error.js";
import { iconA11yProps, renderableIconProps } from "../src/render/props.js";
import type { AccessibleElementInput } from "../src/render/props.js";
import type { LiveCollectionName } from "../typings/names";
import type { IconEntry } from "../typings/types";

/**
 * Renders one icon from a live collection as an inline `<svg>`, resolved at
 * request time instead of build time. Use it when you can't know your icon
 * names ahead of time, such as a user-driven icon search.
 *
 * Requires `defineLiveCollection()` in `live.config.ts`; live content
 * collections are stable as of Astro 6, no experimental flag needed.
 * If the icon fails to resolve,
 * `<LiveIcon>` logs a warning and renders nothing rather than throwing, so
 * one bad icon doesn't take down the page.
 *
 * Decorative by default (`aria-hidden`, invisible to assistive tech), since
 * most icons sit next to visible text or inside an already-labeled control.
 * Providing `title`/`desc` (or your own
 * `aria-label`/`aria-labelledby`/`aria-description`/`aria-describedby`)
 * opts an icon out of that default into a labeled, standalone graphic.
 *
 * Use `<Icon>` instead when your icon names are known at build time; it's
 * cheaper since it resolves once, not on every request.
 */
interface Props extends HTMLAttributes<"svg"> {
  /** The live collection to resolve `icon` from; live collections have no default, unlike `<Icon>`. */
  collection: LiveCollectionName;
  /**
   * The icon's name within `collection`. Always a plain `string`: live
   * collections resolve per-request, so the exact value is often only known
   * at runtime (e.g. a user-driven search) and can't be checked at sync time.
   */
  icon: string;
  /**
   * Adds an accessible `<title>` before the icon body, and takes the icon out
   * of its decorative default. Pass `{ id, value }` instead of a plain string
   * to control the `<title>`'s id, e.g. so something outside the icon can
   * reference it directly.
   */
  title?: string | AccessibleElementInput;
  /**
   * Adds an accessible `<desc>` after `title`, and takes the icon out of its
   * decorative default. Pass `{ id, value }` instead of a plain string to
   * control the `<desc>`'s id, e.g. so something outside the icon can
   * reference it directly.
   */
  desc?: string | AccessibleElementInput;
  /**
   * Sets the icon's accessible description inline, without a separate
   * `<desc>` element to reference. Same relationship to `aria-describedby`
   * as `aria-label` has to `aria-labelledby`.
   *
   * This is a WAI-ARIA 1.3 attribute that Astro's `HTMLAttributes` type
   * doesn't include yet, so it's declared here explicitly.
   */
  "aria-description"?: string;
  /** Sets both `width` and `height` at once. Takes priority over either if both are set. */
  size?: number | string;
  /** The icon's rendered width; defaults to the source SVG's own width. Pass `null` to omit the attribute entirely, e.g. to size the icon from CSS instead. */
  width?: number | string | null;
  /** The icon's rendered height; defaults to the source SVG's own height. Pass `null` to omit the attribute entirely, e.g. to size the icon from CSS instead. */
  height?: number | string | null;
}

const { collection, icon, title, desc, ...props } = Astro.props;

if (!collection || !icon) {
  throw renderTimeError(
    `Invalid "collection" or "icon" provided!`,
    `<LiveIcon> requires both a "collection" and an "icon" prop; got collection="${collection}", icon="${icon}".`,
  );
}

const { entry, error } = await getLiveEntry(collection, icon);

if (error || !entry) {
  const hint = error instanceof AstroIconError ? error.hint : undefined;
  console.warn(
    `<LiveIcon> failed to load "${collection}:${icon}"${error ? `: ${error.message}` : ""}${hint ? `\nHint: ${hint}` : ""}`,
  );
  return;
}

const data = entry.data as IconEntry;
const { a11yProps, titleId, descId, titleText, descText } = iconA11yProps(
  title,
  desc,
  props,
);
const { normalizedProps } = renderableIconProps(data, {
  ...a11yProps,
  ...props,
});
---

<svg {...normalizedProps} data-icon={`${collection}:${icon}`} data-icon-live>
  {titleId && <title id={titleId}>{titleText}</title>}
  {descId && <desc id={descId}>{descText}</desc>}
  <Fragment set:html={data.body} />
</svg>
