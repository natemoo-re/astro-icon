{
  "name": "astro-icon",
  "version": "1.2.0",
  "description": "Icon components and content-layer icon collections for Astro - local SVGs and Iconify icon sets, with typed, autocompleted icon names.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components": "./components/index.ts",
    "./collections": {
      "types": "./dist/collections.d.ts",
      "default": "./dist/collections.js"
    },
    "./source": {
      "types": "./dist/source.d.ts",
      "default": "./dist/source.js"
    },
    "./optimize": {
      "types": "./dist/optimize.d.ts",
      "default": "./dist/optimize.js"
    }
  },
  "files": [
    "components",
    "dist",
    "typings"
  ],
  "scripts": {
    "build": "astro check --tsconfig tsconfig.check.json && tsc",
    "check": "astro check --tsconfig tsconfig.check.json",
    "dev": "tsc --watch",
    "start": "pnpm run dev",
    "test": "vitest run"
  },
  "author": {
    "name": "Nate Moore",
    "email": "nate@natemoo.re",
    "url": "https://twitter.com/n_moore"
  },
  "keywords": [
    "astro",
    "astro-component",
    "withastro",
    "icon",
    "icons",
    "iconify",
    "svg",
    "content-layer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natemoo-re/astro-icon.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/natemoo-re/astro-icon/issues"
  },
  "homepage": "https://github.com/natemoo-re/astro-icon#readme",
  "peerDependencies": {
    "astro": ">=5.0.0",
    "svgo": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "svgo": {
      "optional": true
    }
  },
  "dependencies": {
    "@iconify/tools": "^5.0.12",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.4",
    "ultrahtml": "^1.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^11.1.2",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@types/node": "^22.20.1",
    "astro": "^7.2.2",
    "svgo": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^2.1.9"
  }
}
