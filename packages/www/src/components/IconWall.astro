---
import { Icon } from "astro-icon/components";

// Every icon here is resolved by astro-icon at build time from the `mdi`
// collection in src/content.config.ts — the hero is its own smoke test.
const rows = [
  ["mdi:home", "mdi:account", "mdi:heart", "mdi:star", "mdi:cog", "mdi:bell"],
  ["mdi:magnify", "mdi:camera", "mdi:calendar", "mdi:email", "mdi:lock", "mdi:cloud"],
  ["mdi:music", "mdi:folder", "mdi:rocket", "mdi:fire", "mdi:download", "mdi:upload"],
  ["mdi:pencil", "mdi:image", "mdi:link", "mdi:bookmark", "mdi:flash", "mdi:shield"],
  ["mdi:compass", "mdi:map-marker", "mdi:tag", "mdi:palette", "mdi:leaf", "mdi:code-tags"],
] as const;

const columns = rows[0].length;
const center = { row: (rows.length - 1) / 2, column: (columns - 1) / 2 };
---

<div class="icon-wall" data-icon-wall aria-hidden="true">
  {
    rows.map((row, rowIndex) =>
      row.map((name, columnIndex) => {
        // Icons fade out toward the edges, so the grid reads as a soft cloud
        // rather than a hard-edged block, and animate in from the middle out.
        const distance = Math.hypot(rowIndex - center.row, columnIndex - center.column);
        return (
          <span class="icon-wall__cell" style={{ "--distance": distance.toFixed(3) }}>
            <Icon name={name} width={null} height={null} />
          </span>
        );
      }),
    )
  }
</div>

<script>
  // Dock-style proximity magnification. Purely decorative: without JS the grid
  // still renders every icon, it just doesn't respond to the pointer.
  const RADIUS = 130;

  function setupIconWall(wall: HTMLElement) {
    const cells = Array.from(wall.querySelectorAll<HTMLElement>(".icon-wall__cell"));
    if (cells.length === 0) return;

    // Measuring every cell per pointermove would thrash layout, so centers are
    // cached and only recomputed when the grid's own box actually changes.
    let centers: { x: number; y: number }[] = [];
    let frame = 0;
    let pointer: { x: number; y: number } | null = null;

    const measure = () => {
      const wallRect = wall.getBoundingClientRect();
      centers = cells.map((cell) => {
        const rect = cell.getBoundingClientRect();
        return {
          x: rect.left - wallRect.left + rect.width / 2,
          y: rect.top - wallRect.top + rect.height / 2,
        };
      });
    };

    const render = () => {
      frame = 0;
      cells.forEach((cell, index) => {
        if (!pointer) {
          cell.style.removeProperty("--proximity");
          return;
        }
        const { x, y } = centers[index]!;
        const distance = Math.hypot(pointer.x - x, pointer.y - y);
        const proximity = Math.max(0, 1 - distance / RADIUS);
        // Eased so the falloff feels rounded rather than conical.
        cell.style.setProperty("--proximity", (proximity * proximity).toFixed(3));
      });
    };

    const schedule = () => {
      if (frame) return;
      frame = requestAnimationFrame(render);
    };

    wall.addEventListener("pointermove", (event) => {
      if (event.pointerType === "touch") return;
      const rect = wall.getBoundingClientRect();
      pointer = { x: event.clientX - rect.left, y: event.clientY - rect.top };
      schedule();
    });

    wall.addEventListener("pointerleave", () => {
      pointer = null;
      schedule();
    });

    measure();
    new ResizeObserver(measure).observe(wall);
    wall.dataset.interactive = "true";
  }

  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");
  if (!reduceMotion.matches) {
    document.querySelectorAll<HTMLElement>("[data-icon-wall]").forEach(setupIconWall);
  }
</script>

<style define:vars={{ columns }}>
  .icon-wall {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: clamp(0.4rem, 1.5vw, 0.85rem);
    width: min(100%, 25rem);
    margin-inline: auto;
    color: var(--sl-color-accent);
  }

  .icon-wall__cell {
    --proximity: 0;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 0.7rem;
    background: color-mix(
      in srgb,
      var(--sl-color-accent) calc(8% + var(--proximity) * 26%),
      transparent
    );
    border: 1px solid
      color-mix(in srgb, var(--sl-color-accent) calc(14% + var(--proximity) * 46%), transparent);
    opacity: calc(1 - var(--distance) * 0.22 + var(--proximity) * 0.6);
    transform: scale(calc(1 + var(--proximity) * 0.32))
      translateY(calc(var(--proximity) * -0.22rem));
    animation: icon-wall-in 0.5s both cubic-bezier(0.2, 0.9, 0.3, 1);
    animation-delay: calc(var(--distance) * 90ms);
    /* Only the pointer-driven properties transition; the entrance animation owns the rest. */
    transition:
      background-color 0.18s ease-out,
      border-color 0.18s ease-out;
    will-change: transform;
  }

  /* Lifted tiles stack above their neighbours instead of being clipped by them. */
  .icon-wall__cell:hover {
    z-index: 1;
  }

  .icon-wall__cell :global(svg) {
    width: 58%;
    height: 58%;
    transition: opacity 0.18s ease-out;
  }

  @keyframes icon-wall-in {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .icon-wall__cell {
      animation: none;
      transform: none;
      transition: none;
    }
  }
</style>
