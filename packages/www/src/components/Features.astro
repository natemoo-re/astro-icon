---
import { Icon } from "astro-icon/components";

/**
 * The landing page's feature list. Deliberately covers what the walkthrough
 * sections above *don't* demonstrate, rather than recapping them.
 */
const features = [
  {
    icon: "mdi:language-typescript",
    title: "Typed icon names",
    body: "Every collection generates types. Autocomplete every name, and fail the build on a typo instead of shipping a blank space.",
  },
  {
    icon: "mdi:human",
    title: "Accessible by default",
    body: "Icons render decorative (aria-hidden) so screen readers skip them. Add a title and they become properly labeled graphics automatically.",
  },
  {
    icon: "mdi:feather",
    title: "Nothing ships to the browser",
    body: "Icons resolve during the build and inline as markup. No icon font, no sprite request, no hydration, no layout shift.",
  },
  {
    icon: "mdi:sync",
    title: "Or resolve them per request",
    body: "When names aren't known ahead of time — a search box, a CMS field — <LiveIcon> resolves against a live collection at request time.",
  },
] as const;
---

<ul class="features not-content">
  {
    features.map(({ icon, title, body }) => (
      <li class="features__item">
        <span class="features__icon">
          <Icon name={icon} size={22} />
        </span>
        <div>
          <h3 class="features__title">{title}</h3>
          <p class="features__body">{body}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .features {
    display: grid;
    gap: 1.5rem 2rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .features__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    align-items: start;
  }

  .features__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.6rem;
    color: var(--sl-color-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 22%, transparent);
  }

  .features__title {
    margin: 0.2rem 0 0.3rem;
    font-size: var(--sl-text-base);
    font-weight: 600;
    color: var(--sl-color-white);
    line-height: 1.3;
  }

  .features__body {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    line-height: 1.5;
  }

  @media (min-width: 45rem) {
    .features {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
