---
export const prerender = true;

import { Code } from "astro:components";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import type { IconName } from "astro-icon";
import Base from "../../layouts/base.astro";

const allowlistSnippet = `<!-- allowlist = iconify("ic", { allowed: ["baseline-storage", …] }) -->

<Icon name="allowlist:baseline-storage" />
<!-- ✓ renders -->

<Icon name="allowlist:baseline-alarm" />
<!-- ✗ build fails: "baseline-alarm" isn't in the allowed icon list -->`;

const factsSnippet = `// entryFromSVG() itself never warns or throws for a recoverable problem - it
// just reports what it saw, as "facts", and leaves warn-vs-ignore to the caller:
const { entry, facts } = entryFromSVG(svg);

// localIcons() is that caller: it turns facts into warnings, on every sync.
if (facts.viewBox === "missing") logger.warn(/* ... */);
if (facts.monochromeWithoutCurrentColor) logger.warn(/* ... */);`;

// Counts are read from the real content store, so this page fails loudly if a loader
// silently stops producing entries.
const counts = Object.fromEntries(
  await Promise.all(
    (
      [
        "icons",
        "pack",
        "allowlist",
        "combined",
        "apiOnly",
        "resilient",
        "mixed",
        "lockFixed",
      ] as const
    ).map(async (name) => [name, (await getCollection(name)).length] as const),
  ),
);

const rows: {
  name: string;
  src: string;
  samples: IconName[];
  note?: string;
}[] = [
  {
    name: "icons",
    src: 'defineIconCollection(localIcons("src/icons", { optimize: svgo() }))',
    samples: ["bell", "arrows/left", "arrows/right"],
    note: "nested files keep their path as the name: icons/arrows/left.svg → arrows/left",
  },
  {
    name: "pack",
    src: 'defineIconCollection(iconify("mdi"))',
    samples: ["pack:home-outline", "pack:cog-outline", "pack:folder-outline"],
  },
  {
    name: "allowlist",
    src: 'iconify("ic", { allowed: [...] })',
    samples: [
      "allowlist:baseline-storage",
      "allowlist:baseline-cloud-queue",
      "allowlist:baseline-extension",
    ],
  },
  {
    name: "combined",
    src: 'defineIconCollection([ iconify("fe"), iconify("bi") ])',
    samples: ["combined:activity", "combined:stars"],
  },
  {
    name: "apiOnly",
    src: 'defineIconCollection(iconifyApi("ph", { allowed: [...] }))',
    samples: ["apiOnly:alien", "apiOnly:planet", "apiOnly:rocket-launch"],
    note: "pack not installed - every icon fetched from api.iconify.design at sync time",
  },
  {
    name: "resilient",
    src: 'defineIconCollection([ iconify("mdi"), iconifyApi("mdi") ])',
    samples: ["resilient:home-outline", "resilient:cog-outline"],
  },
  {
    name: "mixed",
    src: 'defineIconCollection([ localIcons("src/icons", { allowed: [...] }), iconify("ri") ])',
    samples: ["mixed:star", "mixed:star-fill"],
  },
  {
    name: "lockFixed",
    src: 'localIcons("src/icons", { allowed: ["lock"], optimize: svgo({ convertColors }) })',
    samples: ["lockFixed:lock"],
  },
];
---

<Base title="Collections" sub="src/content.config.ts">
  <div class="bench">
    <div class="bench__head">
      <span class="bench__title">One collection per source composition</span>
      <span class="bench__note"
        >Counts come from getCollection() at build time</span
      >
    </div>
    <ul class="rows">
      {
        rows.map((row) => (
          <li>
            <span class="name">{row.name}</span>
            <span class="src">
              <code>{row.src}</code>
              {row.note && <span class="src-note">{row.note}</span>}
            </span>
            <span class="count">
              {counts[row.name]?.toLocaleString()} icons
            </span>
            <span class="icons">
              {row.samples.map((name) => (
                <Icon name={name} size={20} />
              ))}
            </span>
          </li>
        ))
      }
    </ul>
    <p class="hint" style="padding: 0.6rem 0.9rem">
      Local <code>.svg</code> files get their root-level <code>fill</code>/<code
        >stroke</code
      > hoisted onto the rendered <code>&lt;svg&gt;</code>, so caller props can
      override them. Iconify pack bodies instead carry
      <code>fill="currentColor"</code> on their inner paths — that's the pack's own
      data, kept verbatim, and it responds to CSS <code>color</code> all the same.
    </p>
  </div>

  <div class="bench">
    <div class="bench__head">
      <span class="bench__title">Allowlist enforcement</span>
      <span class="bench__note"
        >Asking for an icon outside <code>allowed: [...]</code> is a build error,
        not a blank</span
      >
    </div>
    <div class="bench__body">
      <Code code={allowlistSnippet} lang="astro" theme="github-dark-default" />
      <p class="hint" style="margin-top:.6rem">
        Uncomment the second line in <code
          >src/pages/collections/index.astro</code
        > to watch it fail.
      </p>
      {/* <Icon name="allowlist:baseline-alarm" /> */}
    </div>
  </div>

  <div class="bench">
    <div class="bench__head">
      <span class="bench__title">Facts, not policy</span>
      <span class="bench__note"
        >Recoverable problems always warn and sync continues; only an
        unresolvable icon (a missing file, a name outside <code>allowed</code>)
        fails the build</span
      >
    </div>
    <div class="bench__body">
      <Code code={factsSnippet} lang="ts" theme="github-dark-default" />
      <p class="hint" style="margin-top:.6rem">
        Delete any <code>.svg</code> from <code>src/icons/</code> while dev is running
        to watch the <code>icons</code> collection fail on the icon that vanished
        - see <a href="/optimize/">/optimize/</a> for the
        <code>facts.monochromeWithoutCurrentColor</code> warning in action.
      </p>
    </div>
  </div>
</Base>

<style>
  .src-note {
    display: block;
    font-size: 0.68rem;
    color: var(--text-muted);
    opacity: 0.85;
  }
</style>
