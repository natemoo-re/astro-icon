---
export const prerender = true;

import { Icon } from "astro-icon/components";
import Base from "../layouts/base.astro";
---

<Base>
  <h1>Welcome to Astro Icon!</h1>

  <p>
    The <code>icons</code> collection is backed by <code>localIcons()</code> -
    it picks up every <code>.svg</code> in <code>src/icons/</code>
    automatically (subdirectories become part of the name), and watches that
    directory in dev the same way Astro's built-in file-backed collections do.
  </p>

  <article>
    <h2>Local Icons</h2>
    <Icon size={24} name="adjustment" data-icon="adjustment" />
    <Icon size={24} name="annotation" data-icon="annotation" />
    <Icon size={24} name="logos/deno" data-icon="deno" />
    <Icon name="logos/deno" data-icon="deno" />
    <Icon width={75} name="logos/alpine" data-icon="alpine" />
    <Icon name="logos/alpine-multi-color" data-icon="alpine-multi-color" />
  </article>

  <article>
    <h2>Icons from Iconify</h2>
    <p>
      If you can find it on <a href="https://icones.js.org/">Icones</a>, you can
      render it here - each pack is its own collection defined in
      <code>src/content.config.ts</code>.
    </p>
  </article>
  <Icon size={32} name="ic:baseline-account-box" />
  <Icon size={64} name="ic:baseline-account-box" />
  <Icon size={80} name="ic:baseline-account-box" />

  <Icon size={24} name="ic:baseline-directions-run" />
  <Icon name="ic:outline-star" />
  <Icon size={64} name="fe:building" />
  <Icon size={64} name="ri:aliens-fill" />
  <Icon name="bi:stars" />

  <article>
    <h2>A collection combined from multiple packs</h2>
    <p>
      <code>combined</code> is one collection built from an icon in <code>fe</code>
      and an icon in <code>ri</code> via <code>createIconLoader([...])</code> - see
      <code>src/content.config.ts</code>.
    </p>
    <Icon size={32} name="combined:activity" />
    <Icon size={32} name="combined:star-fill" />
  </article>

  <p><a href="/live/">See the &lt;LiveIcon&gt; demo &rarr;</a></p>
  <p><a href="/sprite/">See the &lt;Sprite&gt; demo &rarr;</a></p>
</Base>

<style lang="css">
  [data-icon] {
    color: blue;
  }
  [data-icon="annotation"] {
    color: red;
  }
  [data-icon="deno"] {
    color: #12124b;
  }
  [data-icon="alpine"] {
    color: rgb(45, 52, 65);
  }
</style>
