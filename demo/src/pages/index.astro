---
export const prerender = true;

import { Icon } from "astro-icon/components";
import type { IconName } from "astro-icon";
import Base from "../layouts/base.astro";

const local: IconName[] = [
  "bell",
  "star",
  "rocket",
  "send",
  "globe",
  "layers",
  "badge",
  "check",
  "close",
  "search",
  "link",
  "list",
  "image",
  "trash",
  "bold",
  "italic",
  "underline",
  "align-left",
  "align-center",
  "align-right",
];
---

<Base title="Styling" sub="currentColor · size">
  <div class="bench">
    <div class="bench__head">
      <span class="bench__title">Local icons follow CSS color and size</span>
      <span class="bench__note"
        >Swatches in the top bar recolor everything at once</span
      >
    </div>
    <div class="bench__controls">
      <label class="knob">
        size
        <input type="range" min="12" max="72" value="28" data-size />
        <output data-size-out>28px</output>
      </label>
      <label class="toggle">
        <input type="checkbox" data-labels checked />
        show names
      </label>
    </div>
    <div class="bench__stage">
      <div class="icon-grid" data-grid>
        {
          local.map((name) => (
            <div class="icon-cell">
              <Icon name={name} width={null} height={null} data-sized />
              <code data-label>{name}</code>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="bench">
    <div class="bench__head">
      <span class="bench__title">currentColor vs. hardcoded fill</span>
      <span class="bench__note"
        >All but the hardcoded green lock should react to the swatches</span
      >
    </div>
    <div class="bench__stage">
      <div class="grid-2">
        <div class="icon-cell">
          <Icon name="star" size={40} />
          <code>icons:star — stroke="currentColor"</code>
        </div>
        <div class="icon-cell">
          <Icon name="lockFixed:lock" size={40} />
          <code>lockFixed:lock — svgo() convertColors</code>
        </div>
        <div class="icon-cell">
          <Icon name="lock" size={40} />
          <code>icons:lock — hardcoded #22c55e</code>
        </div>
        <div class="icon-cell">
          <Icon name="combined:stars" size={40} />
          <code>combined:stars — Iconify, currentColor</code>
        </div>
      </div>
    </div>
  </div>

  <div class="bench">
    <div class="bench__head">
      <span class="bench__title">Sizing paths</span>
      <span class="bench__note"
        >Attribute-sized vs. CSS-sized (width={"{null}"})</span
      >
    </div>
    <div class="bench__stage">
      <div class="icon-strip">
        <Icon name="bell" size={16} />
        <Icon name="bell" size={24} />
        <Icon name="bell" size={32} />
        <Icon name="bell" size={48} />
        <Icon name="bell" width={64} height={32} />
        <span class="css-sized"
          ><Icon name="bell" width={null} height={null} /></span
        >
        <span class="chip">width=64 height=32 · then CSS-sized at 3rem</span>
      </div>
    </div>
  </div>

  <div class="bench">
    <div class="bench__head">
      <span class="bench__title">Complex bodies: gradients & animation</span>
      <span class="bench__note"
        >Defs, gradients and SMIL animation pass through; only active content
        (scripts, handlers) is stripped</span
      >
    </div>
    <div class="bench__stage">
      <div class="grid-2">
        <div class="icon-cell">
          <span class="icon-pair"
            ><Icon name="logo" size={40} /><Icon name="logo" size={40} /></span
          >
          <code
            >icons:logo twice — each render gets unique gradient ids, so two
            copies never collide</code
          >
        </div>
        <div class="icon-cell">
          <Icon name="spinner" size={40} />
          <code>icons:spinner — SMIL animateTransform, currentColor stroke</code
          >
        </div>
      </div>
      <p class="hint" style="margin-top:.8rem">
        The gradient logo keeps its own paint on purpose — brand marks shouldn't
        follow <code>currentColor</code>. The spinner does, so the swatches
        recolor it mid-spin.
      </p>
    </div>
  </div>

  <div class="bench">
    <div class="bench__head">
      <span class="bench__title">The <code>data-icon</code> marker</span>
      <span class="bench__note"
        >Every rendered svg carries <code>data-icon="name"</code> — the one attribute
        that identifies astro-icon output</span
      >
    </div>
    <div class="bench__stage">
      <div class="icon-strip marker-demo">
        <Icon name="bell" size={28} />
        <Icon name="star" size={28} />
        <Icon name="check" size={28} />
        <Icon name="pack:home-outline" size={28} />
        <Icon name="star" size={28} />
        <span class="chip"
          >[data-icon="star"] {"{"} color: gold; {"}"} — targets both stars, and only
          them</span
        >
      </div>
    </div>
  </div>
</Base>

<script>
  const size = document.querySelector<HTMLInputElement>("[data-size]")!;
  const out = document.querySelector<HTMLOutputElement>("[data-size-out]")!;
  const grid = document.querySelector<HTMLElement>("[data-grid]")!;
  const labelToggle =
    document.querySelector<HTMLInputElement>("[data-labels]")!;

  // The icons in this grid render with `width={null} height={null}`, so they have no size
  // attributes at all and are sized purely from CSS here.
  function applySize() {
    grid.style.setProperty("--sz", `${size.value}px`);
    out.value = `${size.value}px`;
  }

  size.addEventListener("input", applySize);
  applySize();

  labelToggle.addEventListener("change", () => {
    grid.querySelectorAll<HTMLElement>("[data-label]").forEach((el) => {
      el.hidden = !labelToggle.checked;
    });
  });
</script>

<style>
  .icon-grid :global([data-sized]) {
    width: var(--sz, 28px);
    height: var(--sz, 28px);
  }
  .css-sized :global(svg) {
    width: 3rem;
    height: 3rem;
  }
  .marker-demo :global([data-icon="star"]) {
    color: gold;
  }
  .icon-pair {
    display: inline-flex;
    gap: 0.6rem;
  }
</style>
