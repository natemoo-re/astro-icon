---
export const prerender = true;

import { Icon } from "astro-icon/components";
import Base from "../../layouts/base.astro";

// Every case below is a real <Icon> rendered at build time. The inspector shows that element's
// actual markup straight out of the DOM - nothing is reconstructed in JS, so what you read is
// exactly what astro-icon emitted.
const cases = [
  { id: "default", label: "no props" },
  { id: "size", label: "size={32}" },
  { id: "wh", label: "width/height" },
  { id: "null", label: "width={null}" },
  { id: "title", label: "title" },
  { id: "title-desc", label: "title + desc" },
  { id: "title-id", label: "title={{id,value}}" },
  { id: "aria-label", label: "aria-label" },
  { id: "aria-hidden", label: "aria-hidden={false}" },
  { id: "passthrough", label: "class + data-*" },
];
---

<Base title="Props & a11y" sub="<Icon> output">
  <div class="bench">
    <div class="bench__head">
      <span class="bench__title">Rendered output per prop combination</span>
      <span class="bench__note"
        >Decorative by default; title/desc/aria opt into a labeled graphic</span
      >
    </div>
    <div class="split">
      <div class="cases" role="tablist" aria-label="Prop cases">
        {
          cases.map((c, i) => (
            <button
              class="case-btn"
              type="button"
              role="tab"
              data-case-btn={c.id}
              aria-selected={i === 0 ? "true" : "false"}
            >
              {c.label}
            </button>
          ))
        }
      </div>
      <div class="split__main">
        <div class="stage-center">
          <div data-case="default"><Icon name="bell" /></div>
          <div data-case="size" hidden><Icon name="bell" size={32} /></div>
          <div data-case="wh" hidden>
            <Icon name="bell" width={64} height={32} />
          </div>
          <div data-case="null" hidden class="css-sized">
            <Icon name="bell" width={null} height={null} />
          </div>
          <div data-case="title" hidden>
            <Icon name="bell" size={32} title="Notifications" />
          </div>
          <div data-case="title-desc" hidden>
            <Icon
              name="bell"
              size={32}
              title="Notifications"
              desc="Three unread messages"
            />
          </div>
          <div data-case="title-id" hidden>
            <button class="chip" aria-labelledby="bell-title">
              <Icon
                name="bell"
                size={20}
                title={{ id: "bell-title", value: "Notifications" }}
              />
              button reuses the icon's title id
            </button>
          </div>
          <div data-case="aria-label" hidden>
            <Icon name="bell" size={32} aria-label="Notifications" />
          </div>
          <div data-case="aria-hidden" hidden>
            <Icon name="bell" size={32} aria-hidden={false} />
          </div>
          <div data-case="passthrough" hidden>
            <Icon
              name="bell"
              size={32}
              class="custom-class"
              data-testid="bell"
            />
          </div>
        </div>
        <pre class="inspector" data-inspector></pre>
      </div>
    </div>
  </div>
</Base>

<script>
  const buttons =
    document.querySelectorAll<HTMLButtonElement>("[data-case-btn]");
  const panels = document.querySelectorAll<HTMLElement>("[data-case]");
  const inspector = document.querySelector<HTMLElement>("[data-inspector]")!;

  // Light formatting only - line breaks between tags, no attribute reordering, so the inspector
  // stays faithful to what's actually in the DOM.
  function format(html: string): string {
    return html
      .replace(/></g, ">\n<")
      .split("\n")
      .map((line) => line.trim())
      .filter(Boolean)
      .join("\n");
  }

  function select(id: string) {
    buttons.forEach((b) =>
      b.setAttribute("aria-selected", String(b.dataset.caseBtn === id)),
    );
    let active: HTMLElement | undefined;
    panels.forEach((p) => {
      const match = p.dataset.case === id;
      p.hidden = !match;
      if (match) active = p;
    });
    inspector.textContent = active ? format(active.innerHTML) : "";
  }

  buttons.forEach((btn) =>
    btn.addEventListener("click", () => select(btn.dataset.caseBtn!)),
  );
  select("default");
</script>

<style>
  .css-sized :global(svg) {
    width: 3rem;
    height: 3rem;
  }
  .custom-class {
    opacity: 0.55;
  }
</style>
