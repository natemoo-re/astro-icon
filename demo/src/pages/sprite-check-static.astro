---
// TEMPORARY - manual verification page for the sprite manifest wiring
// (feat/sprite-v2, step 1). Delete once confirmed; the real build-time
// dedup rewrite doesn't exist yet, so repeats below still render as
// separate inline <svg>s here, same as before this feature - this page is
// only proving the plumbing doesn't break the prerendered path.
export const prerender = true;

import { Icon } from "astro-icon/components";
import Base from "../layouts/base.astro";
---

<Base>
  <h1>Sprite check - prerendered</h1>
  <p>Every icon below should render as a plain inline &lt;svg&gt; - no &lt;use&gt;, no <code>data-icon-inline</code>.</p>

  <article>
    <h2>Sprite-eligible collection (ic), repeated</h2>
    <Icon size={24} name="ic:baseline-account-box" />
    <Icon size={24} name="ic:baseline-account-box" />
    <Icon size={24} name="ic:baseline-account-box" />
  </article>

  <article>
    <h2>Same collection, opted out via inline</h2>
    <Icon size={24} name="ic:outline-star" inline />
  </article>
</Base>
