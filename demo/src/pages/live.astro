---
// <LiveIcon> resolves live collections (src/live.config.ts) per request, not at build time.
import { LiveIcon } from "astro-icon/components";
import Base from "../layouts/base.astro";
---

<Base>
  <h1>&lt;LiveIcon&gt; demo</h1>

  <article>
    <h2>Resolved from a locally installed pack</h2>
    <p>
      <code>mdi</code> is installed (<code>@iconify-json/mdi</code>), so these
      resolve from disk.
    </p>
    <LiveIcon collection="mdi" icon="account" />
    <LiveIcon collection="mdi" icon="home" />
  </article>

  <article>
    <h2>Resolved straight from the Iconify API</h2>
    <p>
      <code>ph</code> isn't installed, so these fall back to fetching each
      icon individually from <code>api.iconify.design</code>.
    </p>
    <LiveIcon collection="ph" icon="heart" />
    <LiveIcon collection="ph" icon="star" />
  </article>

  <article>
    <h2>Resolved from a custom source (packages/service)</h2>
    <p>
      Run <code>pnpm --filter service dev</code> for these to render - they're
      backed by <code>serviceSource</code> (<code>packages/service/client.ts</code>),
      a reusable <code>IconSource</code> for this package's own API, not Iconify's.
    </p>
    <LiveIcon collection="service" icon="heart" />
    <LiveIcon collection="service" icon="star" />
  </article>

  <p>
    <a href="/">&larr; Back</a>
    &middot;
    <a href="/search/">Try the &lt;LiveIcon&gt; search demo &rarr;</a>
  </p>
</Base>
