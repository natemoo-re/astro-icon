---
export const prerender = true;

import { Icon, Sprite } from "astro-icon/components";
import Base from "../../layouts/base.astro";
---

<Base>
  <h1>&lt;Sprite&gt; demo</h1>

  <p>
    Wrapping repeated <code>&lt;Icon&gt;</code> usages in a <code>&lt;Sprite&gt;</code>
    dedupes them into one <code>&lt;symbol&gt;</code> per unique icon, referenced by
    <code>&lt;use&gt;</code> everywhere else. View source to see it. Only works on
    prerendered pages (this one sets <code>export const prerender = true</code>).
  </p>

  <article>
    <h2>Inside a Sprite boundary</h2>
    <Sprite>
      <Icon size={32} name="ic:baseline-account-box" />
      <Icon size={32} name="ic:baseline-account-box" />
      <Icon size={32} name="ic:baseline-account-box" />
      <Icon size={32} name="ic:outline-star" />
      <Icon size={32} name="ic:outline-star" />
    </Sprite>
  </article>

  <article>
    <h2>Outside any Sprite boundary</h2>
    <p>Icons rendered outside a <code>&lt;Sprite&gt;</code> are never deduped.</p>
    <Icon size={32} name="ic:baseline-account-box" />
  </article>

  <p><a href="/">&larr; Back home</a></p>
</Base>
