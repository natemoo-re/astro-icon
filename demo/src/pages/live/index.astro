---
export const prerender = false;

import { getLiveCollection, getLiveEntry } from "astro:content";
import type { LiveDataEntry } from "astro";
import { Icon, LiveIcon } from "astro-icon/components";
import type { IconEntry } from "astro-icon";
import Base from "../../layouts/base.astro";

const SOURCES = [
  {
    id: "mdi",
    label: "local pack",
    note: "@iconify-json/mdi installed - resolves from disk",
  },
  {
    id: "ph",
    label: "Iconify API",
    note: "not installed - fetched per icon from api.iconify.design",
  },
  {
    id: "service",
    label: "custom source",
    note: "packages/service - run `pnpm --filter service dev`",
  },
] as const;

type SourceId = (typeof SOURCES)[number]["id"];

const params = Astro.url.searchParams;
const collection = (SOURCES.find((s) => s.id === params.get("collection"))
  ?.id ?? "mdi") as SourceId;
const icon = params.get("icon")?.trim() || "home";

// Resolved here as well as by <LiveIcon> so the bench can report *why* an icon didn't render.
// <LiveIcon> itself logs a warning and renders its "fallback" slot on a miss, by design.
const { entry, error } = await getLiveEntry(collection, icon);
const active = SOURCES.find((s) => s.id === collection)!;

const batchQuery =
  params.get("batch")?.trim() || "home, heart, not-a-real-icon";
const batchNames = batchQuery
  .split(",")
  .map((n) => n.trim())
  .filter(Boolean);

// Counts every request this route makes to api.iconify.design, so the batching payoff below is
// measured, not asserted - the same trick examples/platform-builder/src/pages/search.astro uses.
let batchRequestCount = 0;
const realFetch = globalThis.fetch;
globalThis.fetch = (async (...args: Parameters<typeof fetch>) => {
  if (String(args[0]).includes("api.iconify.design")) batchRequestCount++;
  return realFetch(...args);
}) as typeof fetch;

const batchStart = performance.now();
const batchResult = await getLiveCollection("ph", { ids: batchNames });
// Cast for the same reason the single-lookup bench above casts `entry.data`: Astro's generated
// live-collection types don't narrow `entries`'s element type here.
const batchEntries = (batchResult.entries ?? []) as LiveDataEntry<IconEntry>[];
const batchMs = Math.round(performance.now() - batchStart);
globalThis.fetch = realFetch;
---

<Base title="Live icons" sub="<LiveIcon> · per request">
  <div class="bench">
    <div class="bench__head">
      <span class="bench__title"
        >Resolve any icon name, server-side, on every request</span
      >
      <span class="bench__note">{active.note}</span>
    </div>
    <form class="bench__controls" method="get">
      <label class="knob">
        source
        <select name="collection">
          {
            SOURCES.map((s) => (
              <option value={s.id} selected={s.id === collection}>
                {s.id} — {s.label}
              </option>
            ))
          }
        </select>
      </label>
      <label class="knob">
        icon
        <input
          type="text"
          name="icon"
          value={icon}
          placeholder="e.g. home, heart, alien"
        />
      </label>
      <button class="button" type="submit">
        <Icon name="arrows/right" size={14} aria-hidden="true" />
        resolve
      </button>
      <span class="hint">try a bogus name to see the miss path</span>
    </form>
    <div class="stage-center">
      <LiveIcon collection={collection} icon={icon} size={64}>
        <span
          class="fallback-badge"
          slot="fallback"
          style="width:64px;height:64px;font-size:26px"
        >
          ?
        </span>
      </LiveIcon>
      {!entry && <span class="hint">rendered its fallback slot below</span>}
    </div>
    <pre
      class="inspector">{
      entry
        ? `✓ ${collection}:${icon}\n  viewBox="${(entry.data as any).viewBox}" ${(entry.data as any).width}×${(entry.data as any).height}\n  body ${(entry.data as any).body.length} bytes`
        : `✗ ${collection}:${icon}\n  ${error ? error.message : "no entry returned"}\n  <LiveIcon> logged a warning and rendered its "fallback" slot instead.`
    }</pre>
  </div>

  <div class="bench">
    <div class="bench__head">
      <span class="bench__title">Batch-resolve many at once</span>
      <span class="bench__note"
        >getLiveCollection(collection, {"{ ids }"}) - one request for every name
        below</span
      >
    </div>
    <form class="bench__controls" method="get">
      <label class="knob" style="flex:1">
        names, comma-separated
        <input
          type="text"
          name="batch"
          value={batchQuery}
          placeholder="home, heart, alien"
          style="flex:1"
        />
      </label>
      <button class="button" type="submit">
        <Icon name="arrows/right" size={14} aria-hidden="true" />
        resolve
      </button>
      <span class="stat"
        ><strong>{batchRequestCount}</strong> request{
          batchRequestCount === 1 ? "" : "s"
        } to api.iconify.design in {batchMs}ms for {batchNames.length} name{
          batchNames.length === 1 ? "" : "s"
        }</span
      >
    </form>
    <div class="bench__stage">
      <p class="hint">
        <code>entry</code> addressing - only names that actually resolved, from the
        batch call's own return value
      </p>
      <div class="icon-grid">
        {
          batchEntries.map((entry) => (
            <div class="icon-cell">
              <LiveIcon collection="ph" entry={entry} size={28} />
              <code>{entry.id}</code>
            </div>
          ))
        }
      </div>
      <p class="hint" style="margin-top:1rem">
        <code>icon</code> addressing - every requested name, resolved from the cache
        the call above warmed; a miss renders the <code>fallback</code> slot
      </p>
      <div class="icon-grid">
        {
          batchNames.map((name) => (
            <div class="icon-cell">
              <LiveIcon collection="ph" icon={name} size={28}>
                <span
                  class="fallback-badge"
                  slot="fallback"
                  style="width:28px;height:28px;font-size:13px"
                >
                  ?
                </span>
              </LiveIcon>
              <code>{name}</code>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="bench">
    <div class="bench__head">
      <span class="bench__title">Search &amp; resolve</span>
      <span class="bench__note"
        >Only the icons shown are ever resolved, not the whole pack</span
      >
    </div>
    <div class="bench__controls">
      <div class="segmented" data-packs role="tablist" aria-label="Search pack">
        <button type="button" role="tab" aria-selected="true" data-pack="mdi">
          <Icon
            name="allowlist:baseline-storage"
            size={14}
            aria-hidden="true"
          />
          mdi
        </button>
        <button type="button" role="tab" aria-selected="false" data-pack="ph">
          <Icon
            name="allowlist:baseline-cloud-queue"
            size={14}
            aria-hidden="true"
          />
          ph
        </button>
      </div>
      <label class="knob" style="flex:1">
        <Icon name="search" size={15} aria-hidden="true" />
        <input
          type="search"
          placeholder="Search icons…"
          autocomplete="off"
          data-query
          style="flex:1"
        />
      </label>
      <span class="stat" data-status></span>
    </div>
    <div class="bench__stage">
      <div class="icon-grid" data-results></div>
      <p class="empty" data-empty>Type to search.</p>
    </div>
  </div>
</Base>

<script>
  interface IconResult {
    name: string;
    body: string;
    viewBox: string;
    width: number;
    height: number;
  }

  const DEBOUNCE_MS = 250;

  const input = document.querySelector<HTMLInputElement>("[data-query]")!;
  const results = document.querySelector<HTMLElement>("[data-results]")!;
  const status = document.querySelector<HTMLElement>("[data-status]")!;
  const empty = document.querySelector<HTMLElement>("[data-empty]")!;
  const packButtons =
    document.querySelectorAll<HTMLButtonElement>("[data-pack]");

  let pack = "mdi";
  let debounceTimer: ReturnType<typeof setTimeout> | undefined;
  let controller: AbortController | undefined;

  packButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      packButtons.forEach((b) =>
        b.setAttribute("aria-selected", String(b === btn)),
      );
      pack = btn.dataset.pack!;
      search(input.value);
    });
  });

  input.addEventListener("input", () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => search(input.value), DEBOUNCE_MS);
  });

  async function search(rawQuery: string) {
    const query = rawQuery.trim();
    controller?.abort();

    if (!query) {
      results.replaceChildren();
      status.textContent = "";
      empty.hidden = false;
      return;
    }

    controller = new AbortController();
    status.textContent = "resolving…";
    empty.hidden = true;

    let response: Response;
    const started = performance.now();
    try {
      response = await fetch(
        `/api/icon-search?pack=${pack}&q=${encodeURIComponent(query)}`,
        {
          signal: controller.signal,
        },
      );
    } catch (err) {
      if ((err as Error).name === "AbortError") return;
      status.textContent = "request failed";
      return;
    }

    const data = (await response.json()) as {
      results: IconResult[];
      error?: string;
    };
    if (data.error) {
      status.textContent = data.error;
      return;
    }

    const ms = Math.round(performance.now() - started);
    status.textContent = `${data.results.length} resolved in ${ms}ms`;
    empty.hidden = data.results.length > 0;

    results.replaceChildren(
      ...data.results.map((icon) => {
        const cell = document.createElement("div");
        cell.className = "icon-cell";

        const svg = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "svg",
        );
        svg.setAttribute("width", "24");
        svg.setAttribute("height", "24");
        svg.setAttribute("viewBox", icon.viewBox);
        svg.innerHTML = icon.body;

        const label = document.createElement("code");
        label.textContent = icon.name;

        cell.append(svg, label);
        return cell;
      }),
    );
  }
</script>
