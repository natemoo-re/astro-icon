---
import { Icon } from "astro-icon/components";
import type { IconName } from "astro-icon";

const links: { href: string; label: string; icon: IconName }[] = [
  { href: "/", label: "Styling", icon: "pack:palette-outline" },
  { href: "/patterns/", label: "Patterns", icon: "pack:widgets-outline" },
  { href: "/props/", label: "Props & a11y", icon: "pack:tune-variant" },
  { href: "/collections/", label: "Collections", icon: "pack:layers-outline" },
  { href: "/live/", label: "Live icons", icon: "pack:lightning-bolt-outline" },
  { href: "/optimize/", label: "Optimize", icon: "pack:auto-fix" },
  { href: "/playground/", label: "Playground", icon: "pack:flask-outline" },
];

const current = Astro.url.pathname;
---

<nav class="rail" aria-label="Benches">
  <div class="rail__brand" aria-hidden="true">
    <Icon name="logo" size={20} />
  </div>
  {
    links.map((link) => (
      <a
        class="rail__link"
        href={link.href}
        title={link.label}
        aria-label={link.label}
        aria-current={current === link.href ? "page" : undefined}
      >
        <Icon name={link.icon} size={19} />
      </a>
    ))
  }
</nav>
