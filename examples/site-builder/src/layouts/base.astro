---
import { Icon } from "astro-icon/components";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;

// The same four nav icons render once in the header and once in the footer
// of every page - no config, no wrapper component.
const navLinks = [
  { href: "/", label: "Home", icon: "home" },
  { href: "/blog", label: "Blog", icon: "mail" },
  { href: "/about", label: "About", icon: "user" },
] as const;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · Site Builder Example</title>
  </head>
  <body>
    <header>
      <div class="wrap">
        <a class="brand" href="/">
          <Icon name="menu" size={20} />
          Acme Blog
        </a>
        <nav>
          {
            navLinks.map((link) => (
              <a href={link.href}>
                <Icon name={link.icon} size={18} />
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <nav>
          {
            navLinks.map((link) => (
              <a href={link.href}>
                <Icon name={link.icon} size={16} />
                {link.label}
              </a>
            ))
          }
        </nav>
        <p>
          <Icon name="star" size={16} /> Star us on GitHub
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  header {
    border-bottom: 1px solid rgb(var(--gray-light));
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(6px);
    position: sticky;
    top: 0;
  }
  header .wrap,
  footer .wrap {
    width: 42rem;
    max-width: calc(100% - 2em);
    margin: auto;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 0;
  }
  header .wrap {
    justify-content: space-between;
  }
  footer {
    border-top: 1px solid rgb(var(--gray-light));
    margin-top: 2rem;
  }
  footer .wrap {
    flex-direction: column;
    align-items: flex-start;
    color: rgb(var(--gray));
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
    color: rgb(var(--black));
  }
  nav {
    display: flex;
    gap: 1.25rem;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    color: rgb(var(--gray-dark));
    font-weight: 500;
  }
  nav a:hover {
    color: var(--accent);
  }
</style>
