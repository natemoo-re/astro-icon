---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
}

const { title } = Astro.props;

// The same four nav icons render once in the header and once in the footer
// of every page - no config, no wrapper component. Because both live on the
// same page, astro-icon's automatic sprite optimization collapses each into
// one <symbol> + two <use> elements at build time. Nothing here opts in;
// nothing could opt out short of `inline` on a specific <Icon>.
const navLinks = [
  { href: "/", label: "Home", icon: "home" },
  { href: "/blog", label: "Blog", icon: "mail" },
  { href: "/about", label: "About", icon: "user" },
] as const;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · Site Builder Example</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/">
        <Icon name="menu" size={20} />
        Acme Blog
      </a>
      <nav>
        {navLinks.map((link) => (
          <a href={link.href}>
            <Icon name={link.icon} size={18} />
            {link.label}
          </a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <nav>
        {navLinks.map((link) => (
          <a href={link.href}>
            <Icon name={link.icon} size={16} />
            {link.label}
          </a>
        ))}
      </nav>
      <p>
        <Icon name="star" size={16} /> Star us on GitHub
      </p>
    </footer>
  </body>
</html>

<style>
  body {
    font-family: system-ui, sans-serif;
    max-width: 40rem;
    margin: 0 auto;
    padding: 1rem;
    color: #1a1a1a;
  }
  header,
  footer {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 0;
  }
  header {
    justify-content: space-between;
    border-bottom: 1px solid #e2e2e2;
  }
  footer {
    flex-direction: column;
    align-items: flex-start;
    border-top: 1px solid #e2e2e2;
    margin-top: 2rem;
    color: #666;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    text-decoration: none;
    color: inherit;
  }
  nav {
    display: flex;
    gap: 1rem;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    color: inherit;
  }
</style>
