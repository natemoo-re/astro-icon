---
import { Icon } from "astro-icon/components";
import Base from "../layouts/base.astro";
---

<Base title="Home">
  <h1>Welcome to Acme Blog</h1>
  <p>
    This is the <strong>site builder</strong> persona: a marketing site with
    a handful of prerendered pages, ~10 local icons, and zero sprite
    configuration anywhere in this project. Look at <code>astro.config.mjs</code>
    and <code>src/content.config.ts</code> - that's the entire setup.
  </p>

  <section>
    <h2>Why teams pick us</h2>
    <ul class="features">
      <li><Icon name="check" size={20} /> Ships static HTML, no client JS</li>
      <li><Icon name="star" size={20} /> Full TypeScript autocomplete for icon names</li>
    </ul>
    <a class="cta" href="/blog">
      Read the blog <Icon name="arrow-right" size={16} />
    </a>
  </section>

  <p class="note">
    View source on this page: <code>check</code>, <code>star</code>, and
    <code>arrow-right</code> are each used once here, so they stay plain
    inline <code>&lt;svg&gt;</code> elements - no <code>&lt;symbol&gt;</code>
    for them. The header/footer nav icons above and below, which repeat, do
    get deduped. Same build, same page, two different outcomes, decided
    automatically.
  </p>
</Base>
