---
import { Icon } from "astro-icon/components";
import Base from "../layouts/base.astro";
---

<Base title="About">
  <h1>About Acme Blog</h1>
  <p>
    <Icon name="user" size={20} /> We're a small team writing about things we
    build. This page exists mostly to prove the nav icons above and below
    repeat identically on every route in this site - <code>home</code>,
    <code>mail</code>, and <code>user</code> collapse into shared
    <code>&lt;symbol&gt;</code>s here too, exactly like on the home page,
    with nothing page-specific configured.
  </p>
</Base>
