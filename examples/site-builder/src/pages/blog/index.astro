---
import { Icon } from "astro-icon/components";
import Base from "../../layouts/base.astro";

const posts = [
  { slug: "hello-world", title: "Hello, world", date: "2026-01-12" },
];
---

<Base title="Blog">
  <h1>Blog</h1>
  <ul class="posts">
    {
      posts.map((post) => (
        <li class="card">
          <a href={`/blog/${post.slug}`}>{post.title}</a>
          <span class="date">
            <Icon name="calendar" size={14} /> {post.date}
          </span>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .posts {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75em;
  }
  .posts li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1em 1.25em;
  }
  .posts a {
    font-weight: 600;
    color: rgb(var(--black));
    text-decoration: none;
  }
  .posts a:hover {
    color: var(--accent);
  }
  .date {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: rgb(var(--gray));
    font-size: 0.9em;
  }
</style>
