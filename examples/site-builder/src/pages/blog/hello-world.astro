---
import { Icon } from "astro-icon/components";
import Base from "../../layouts/base.astro";
---

<Base title="Hello, world">
  <article class="card">
    <h1>Hello, world</h1>
    <p class="meta">
      <span><Icon name="calendar" size={16} /> Published 2026-01-12</span>
      <span><Icon name="heart" size={16} /> 12 likes</span>
      <span><Icon name="check" size={16} /> Verified author</span>
    </p>
    <p>
      Every icon on this page - <code>calendar</code>, <code>heart</code>,
      <code>check</code> here, plus the nav icons in the header/footer - comes from
      the same <code>icons</code> collection: a directory of local
      <code>.svg</code> files, nothing else. There's no other configuration anywhere
      in this project.
    </p>
  </article>
</Base>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25em;
    color: rgb(var(--gray));
    font-size: 0.9em;
  }
  .meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
  }
</style>
