---
// A custom IconSource - the plug point for a backend astro-icon doesn't ship.
// The `brand` live collection is served by src/lib/brandKitSource.ts: three
// methods (`name`, `getIcon`, optional `listIcons`), standing in for a
// per-tenant brand kit - a design-tool export or a database table, where the
// icons aren't yours and can change without a deploy.
export const prerender = false;

import { getLiveCollection } from 'astro:content';
import { LiveIcon } from 'astro-icon/components';
import HeroText from '~/components/widgets/HeroText.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Brand kits',
};

// `listIcons()` on the custom source is what makes this possible: the page asks
// the backend what it holds instead of hardcoding names. A source that only
// implements `getIcon` still works with <LiveIcon>, it just can't be enumerated.
const { entries, error } = await getLiveCollection('brand');
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Icons from your tenants"
    title="Icons from a custom source"
    subtitle={`A backend astro-icon doesn't ship: the <code>brand</code> collection is served by a custom <code>IconSource</code> in <code>src/lib/brandKitSource.ts</code>, resolved per request through a live collection.`}
  />

  <section class="max-w-3xl mx-auto px-4 sm:px-6 pb-16 md:pb-20">
    {error && <p class="text-red-600 dark:text-red-400 mb-8">Couldn't load the brand kit: {error.message}</p>}

    {
      entries && (
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
          {entries.map((entry) => (
            <div class="flex flex-col items-center gap-2 rounded-lg border border-gray-200 dark:border-slate-800 p-5 text-center">
              <LiveIcon collection="brand" icon={entry.id} size={32} class="text-primary" />
              <code class="text-xs text-muted break-all">{entry.id}</code>
            </div>
          ))}
        </div>
      )
    }

    <p class="text-sm text-muted">
      The source's <code>name</code> has to match the key it's registered under in <code>src/live.config.ts</code>. A
      <code>LiveLoader</code> is never told its own collection name, so typegen records the live collection under the
      source's name instead - if they drift, <code>&lt;LiveIcon collection="brand"&gt;</code> stops type-checking
      against a collection that appears not to exist.
    </p>
  </section>
</Layout>
