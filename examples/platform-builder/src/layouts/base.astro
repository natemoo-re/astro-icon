---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "CMS-driven nav" },
  { href: "/picker", label: "Catalog picker" },
  { href: "/search", label: "Live search" },
  { href: "/brand", label: "Brand kits" },
] as const;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · Platform Builder</title>
  </head>
  <body>
    <header>
      <div class="wrap">
        <span class="brand">Platform Builder</span>
        <nav class="top">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class:list={{ active: link.href === currentPath }}
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  header {
    background: white;
    border-bottom: 1px solid rgb(var(--gray-light));
  }
  .wrap {
    max-width: 50rem;
    margin: 0 auto;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .brand {
    font-weight: 700;
    color: rgb(var(--black));
  }
  nav.top {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  nav.top a {
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    text-decoration: none;
    color: rgb(var(--gray-dark));
    font-size: 0.9rem;
    font-weight: 500;
  }
  nav.top a:hover {
    background: var(--accent-light);
    color: var(--accent-dark);
  }
  nav.top a.active {
    background: var(--accent);
    color: white;
  }
  main {
    max-width: 50rem;
    margin: 0 auto;
    padding: 2rem 1.25rem;
  }
</style>
