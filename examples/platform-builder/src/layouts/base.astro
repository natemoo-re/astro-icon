---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · Platform Builder</title>
  </head>
  <body>
    <nav class="top">
      <a href="/">CMS-driven nav</a>
      <a href="/picker">Catalog picker</a>
      <a href="/search">Live search</a>
      <a href="/brand">Brand kits</a>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  body {
    font-family: system-ui, sans-serif;
    max-width: 46rem;
    margin: 0 auto;
    padding: 1rem;
    color: #1a1a1a;
  }
  nav.top {
    display: flex;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #e2e2e2;
    margin-bottom: 1.5rem;
  }
  .note {
    color: #555;
    background: #f6f6f7;
    border-left: 3px solid #ccc;
    padding: 0.6rem 0.9rem;
    margin: 1rem 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
    gap: 0.75rem;
  }
  .cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 0.6rem;
    border: 1px solid #e6e6e6;
    border-radius: 0.375rem;
    font-size: 0.75rem;
    text-align: center;
  }
</style>
