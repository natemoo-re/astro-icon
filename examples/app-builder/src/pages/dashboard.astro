---
// No `export const prerender`, so with `output: "server"` this route is SSR
// by default - a real dashboard, rendered fresh per request. `<Icon>`
// resolves against the same `mdi`/`brand` collections either way; nothing
// about this page differs from a prerendered one except when it runs.
import { Icon } from "astro-icon/components";
import App from "../layouts/app.astro";

const rows = Array.from({ length: 40 }, (_, i) => ({
  id: i + 1,
  name: `user-${i + 1}@example.com`,
  role: i % 5 === 0 ? "Admin" : "Member",
}));
---

<App title="Users">
  <div class="toolbar">
    <h1>Users</h1>
    <button class="btn"><Icon name="mdi:plus" size={16} /> Invite</button>
  </div>

  <p class="note">
    Every row below repeats the same three action icons -
    <code>mdi:eye</code>, <code>mdi:pencil</code>, <code>mdi:delete</code> - 40 times
    each, 120 icon usages total, each a plain inline
    <code>&lt;svg&gt;</code>. Rendered fresh per request, same as everything
    else on this route.
  </p>

  <div class="card">
    <table>
      <thead>
        <tr>
          <th>User</th>
          <th>Role</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              <td>{row.name}</td>
              <td>
                <span class:list={["badge", { admin: row.role === "Admin" }]}>
                  {row.role}
                </span>
              </td>
              <td class="actions">
                <Icon name="mdi:eye" size={16} />
                <Icon name="mdi:pencil" size={16} />
                <Icon name="mdi:delete" size={16} />
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</App>

<style>
  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .note {
    color: rgb(var(--gray));
    max-width: 42rem;
    margin: 0 0 1.25rem 0;
  }
  .card {
    overflow: hidden;
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th {
    text-align: left;
    padding: 0.7rem 1.25rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: rgb(var(--gray));
    border-bottom: 1px solid rgb(var(--gray-light));
  }
  td {
    text-align: left;
    padding: 0.6rem 1.25rem;
    border-bottom: 1px solid rgb(var(--gray-light));
  }
  tr:last-child td {
    border-bottom: none;
  }
  .badge {
    display: inline-block;
    padding: 0.2em 0.7em;
    border-radius: 999px;
    font-size: 0.8em;
    font-weight: 600;
    background: rgb(var(--gray-light));
    color: rgb(var(--gray-dark));
  }
  .badge.admin {
    background: var(--accent-light);
    color: var(--accent-dark);
  }
  .actions {
    display: flex;
    gap: 0.75rem;
    color: rgb(var(--gray));
  }
  .actions :global(svg:hover) {
    color: var(--accent);
  }
</style>
