---
// No `export const prerender`, so with `output: "server"` this route is SSR
// by default - a real dashboard, rendered fresh per request. This is where
// UC1 ("same icon 40x on one page") and H4 (an external sprite asset gets
// emitted because an SSR route references this collection) both live.
import { Icon } from "astro-icon/components";
import App from "../layouts/app.astro";

const rows = Array.from({ length: 40 }, (_, i) => ({
  id: i + 1,
  name: `user-${i + 1}@example.com`,
  role: i % 5 === 0 ? "Admin" : "Member",
}));
---

<App title="Users">
  <div class="toolbar">
    <h1>Users</h1>
    <button><Icon name="mdi:plus" size={16} /> Invite</button>
  </div>

  <p class="note">
    Every row below repeats the same three action icons -
    <code>mdi:eye</code>, <code>mdi:pencil</code>, <code>mdi:delete</code> -
    40 times each, 120 icon usages total from three symbols. Because this
    route is server-rendered, `&lt;Icon&gt;` can't rewrite the page after the
    fact the way a prerendered page can; instead each usage references a
    shared external sprite asset emitted for the <code>mdi</code> collection
    at build time. Check the response HTML (view-source, not devtools, so you
    see what the server actually sent) for
    <code>&lt;use href="/_astro/mdi.&lt;hash&gt;.svg#..."&gt;</code>.
  </p>

  <table>
    <thead>
      <tr>
        <th>User</th>
        <th>Role</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <td>{row.name}</td>
          <td>{row.role}</td>
          <td class="actions">
            <Icon name="mdi:eye" size={16} />
            <Icon name="mdi:pencil" size={16} />
            <Icon name="mdi:delete" size={16} />
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</App>

<style>
  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .note {
    color: #666;
    max-width: 42rem;
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th,
  td {
    text-align: left;
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid #eee;
  }
  .actions {
    display: flex;
    gap: 0.5rem;
  }
  button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
</style>
