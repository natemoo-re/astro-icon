---
// Prerendered even though the app's default output is "server" - a login
// screen has nothing user-specific to render per request. Same `mdi`/`brand`
// collections as /dashboard, resolved at build time instead of per request.
export const prerender = true;

import { Icon } from "astro-icon/components";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Sign in · Dashboard</title>
  </head>
  <body>
    <main>
      <form class="card">
        <Icon name="brand:logo" size={28} />
        <h1>Sign in</h1>
        <label>
          <span><Icon name="mdi:email" size={14} /> Email</span>
          <input type="email" name="email" />
        </label>
        <label>
          <span><Icon name="mdi:lock" size={14} /> Password</span>
          <input type="password" name="password" />
        </label>
        <button class="btn" type="submit">Sign in</button>
        <a class="back" href="/dashboard"
          ><Icon name="mdi:arrow-left" size={14} /> Back to dashboard</a
        >
      </form>
    </main>
  </body>
</html>

<style>
  body {
    display: flex;
    min-height: 100vh;
    align-items: center;
    justify-content: center;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem;
    width: 20rem;
  }
  h1 {
    font-size: 1.4rem;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9rem;
  }
  label span {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: rgb(var(--gray-dark));
    font-weight: 500;
  }
  input {
    font: inherit;
    padding: 0.5rem 0.7rem;
    border: 1px solid rgb(var(--gray-light));
    border-radius: 8px;
  }
  input:focus {
    outline: 2px solid var(--accent-light);
    border-color: var(--accent);
  }
  .btn {
    justify-content: center;
    margin-top: 0.25rem;
  }
  .back {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: rgb(var(--gray));
    text-decoration: none;
  }
  .back:hover {
    color: var(--accent);
  }
</style>
