---
import { Icon } from "astro-icon/components";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;

const navLinks = [
  { href: "/dashboard", label: "Dashboard", icon: "mdi:view-dashboard" },
  { href: "/dashboard", label: "Users", icon: "mdi:account-group" },
  { href: "/dashboard", label: "Reports", icon: "mdi:chart-line" },
  { href: "/dashboard", label: "Settings", icon: "mdi:cog" },
] as const;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · Dashboard</title>
  </head>
  <body>
    <div class="shell">
      <aside>
        <a class="brand" href="/dashboard">
          <Icon name="brand:logo" size={22} /> Acme Admin
        </a>
        <nav>
          {
            navLinks.map((link, i) => (
              <a href={link.href} class:list={{ active: i === 0 }}>
                <Icon name={link.icon} size={18} /> {link.label}
              </a>
            ))
          }
        </nav>
      </aside>
      <div class="main">
        <header>
          <div class="search">
            <Icon name="mdi:magnify" size={18} />
            <span>Search</span>
          </div>
          <span class="spacer"></span>
          <Icon name="mdi:bell" size={18} />
          <Icon name="mdi:logout" size={18} />
        </header>
        <main>
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>

<style>
  .shell {
    display: flex;
    min-height: 100vh;
  }
  aside {
    width: 15rem;
    flex-shrink: 0;
    background: rgb(var(--gray-dark));
    color: white;
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    text-decoration: none;
    color: white;
  }
  nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  nav a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.925rem;
  }
  nav a:hover {
    color: white;
    background: rgba(255, 255, 255, 0.08);
  }
  nav a.active {
    color: white;
    background: var(--accent);
  }
  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1.75rem;
    background: white;
    border-bottom: 1px solid rgb(var(--gray-light));
  }
  .search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: rgb(var(--gray));
    background: rgb(var(--gray-light));
    border-radius: 8px;
    padding: 0.4rem 0.75rem;
    font-size: 0.9rem;
  }
  .spacer {
    flex: 1;
  }
  main {
    padding: 1.75rem;
  }
</style>
