---
// A library-authored component. It renders one of *its own* icons - never a
// name the consumer supplies - so it can guarantee the name exists without
// the consumer configuring anything.
interface Props {
  icon: "chevron-right" | "close" | "spinner";
}

import { Icon } from "astro-icon/components";

const { icon } = Astro.props;
---

<button class="acme-icon-button">
  <Icon name={`acme-ui-icons:${icon}`} size={18} />
  <slot />
</button>

<style>
  .acme-icon-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5em 1em;
    border: 1px solid rgb(var(--gray-light));
    border-radius: 999px;
    background: white;
    color: rgb(var(--gray-dark));
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }
  .acme-icon-button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .acme-icon-button :global(.spinner-head) {
    transform-origin: center;
    animation: acme-spin 0.8s linear infinite;
  }
  @keyframes acme-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
