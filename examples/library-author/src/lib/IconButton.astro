---
// A library-authored component. It renders one of *its own* icons - never a
// name the consumer supplies - so it can guarantee the name exists without
// the consumer configuring anything.
//
// `animateIcon` is UC4 (see examples/PERSONA.md): "I need to animate/style the
// icon's internals." `spinner.svg` has two paths (`.spinner-track`,
// `.spinner-head`) meant to be styled independently, but CSS can't reach
// through a `<use>`'s referenced content once an icon is sprited. A library
// component can't know whether *this* usage needs that - the consumer does -
// so it's exposed as a prop that forwards to `<Icon inline>` rather than the
// library guessing, and rather than shipping a `<SpriteSheet>` the consumer
// would have to place (which would fail this persona outright: a library
// can't touch the consumer's layout).
interface Props {
  icon: "chevron-right" | "close" | "spinner";
  animateIcon?: boolean;
}

import { Icon } from "astro-icon/components";

const { icon, animateIcon = false } = Astro.props;
---

<button class="acme-icon-button">
  <Icon name={`acme-ui-icons:${icon}`} size={18} inline={animateIcon} />
  <slot />
</button>

<style>
  .acme-icon-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid #ccc;
    border-radius: 0.375rem;
    background: white;
    font: inherit;
  }
  .acme-icon-button :global(.spinner-head) {
    transform-origin: center;
    animation: acme-spin 0.8s linear infinite;
  }
  @keyframes acme-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
